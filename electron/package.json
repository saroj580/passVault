{
  "name": "passvault",
  "productName": "PassVault",
  "version": "1.0.0",
  "description": "PassVault desktop app",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --dir"
  },
  "devDependencies": {
    "electron": "44.4.5",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.passvault.app",
    "productName": "PassVault",
    "directories": {
      "output": "../dist/electron-out"
    },
    "win": {
      "target": "dir"
    },
    "files": [
      "main.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../backend/dist/backend",
        "to": "backend",
        "filter": ["**/*"]
      }
    ]
  }
}
